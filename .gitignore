const seedTracks = [
  {
    title: "Neon Horizon",
    mood: "Dreamy",
    genre: "Electronic",
    length: "2:14",
    vibe: "Cinematic",
    acoustic: 64,
  },
  {
    title: "Glass Hearts",
    mood: "Melancholic",
    genre: "Indie Pop",
    length: "2:48",
    vibe: "Atmospheric",
    acoustic: 72,
  },
  {
    title: "Afterglow Run",
    mood: "Energetic",
    genre: "Synthwave",
    length: "3:06",
    vibe: "Festival",
    acoustic: 88,
  },
];

const form = document.getElementById("song-form");
const trackList = document.getElementById("track-list");

const buildWaveform = (intensity) => {
  const heights = [18, 27, 41, 24, 33, 48, 20, 34, 14, 28, 44, 30, 22, 40, 18, 25];
  return heights
    .map((height, index) => {
      const value = Math.max(10, Math.round((height * intensity) / 100));
      const style = `height: ${value}px; animation-delay: ${index * 0.07}s;`;
      return `<span style="${style}"></span>`;
    })
    .join("");
};

const renderTracks = (tracks) => {
  trackList.innerHTML = tracks
    .map(
      (track) => `
        <article class="track-card">
          <div class="track-top">
            <span class="track-badge">${track.genre}</span>
            <span class="track-stats">${track.length}</span>
          </div>
          <h4>${track.title}</h4>
          <div class="track-meta">
            <span>${track.mood}</span>
            <span>•</span>
            <span>${track.vibe}</span>
          </div>
          <div class="waveform">${buildWaveform(track.acoustic)}</div>
          <div class="track-actions">
            <button class="play-button">Play preview</button>
            <span class="track-stats">${track.acoustic}% energy</span>
          </div>
        </article>
      `,
    )
    .join("");
};

const createTrackFromPrompt = (prompt, genre, mood, length, voice) => {
  const words = prompt
    .toLowerCase()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 4)
    .map((word) => word.replace(/[^a-z]/g, ""));

  const titleWords = words.length ? words : ["Midnight", "Signal", "Echo"];
  const cleanedTitle = titleWords
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

  return {
    title: cleanedTitle || "Golden Echo",
    mood: mood || "Dreamy",
    genre: genre || "Electronic",
    length: length || "2 min",
    vibe: voice || "Neutral",
    acoustic: 42 + Math.floor(Math.random() * 52),
  };
};

const generateTracks = (event) => {
  event.preventDefault();

  const formData = new FormData(form);
  const prompt = formData.get("prompt")?.toString() || "";
  const genre = formData.get("genre")?.toString() || "Electronic";
  const mood = formData.get("mood")?.toString() || "Dreamy";
  const length = formData.get("length")?.toString() || "2 min";
  const voice = formData.get("voice")?.toString() || "Neutral";

  const tracks = Array.from({ length: 3 }, () =>
    createTrackFromPrompt(prompt, genre, mood, length, voice),
  );

  renderTracks(tracks);
};

const applyTemplate = () => {
  document.getElementById("prompt").value =
    "A moody, late-night R&B track with gentle piano, warm bass lines, and soft vocals floating over a cinematic chorus";
  document.getElementById("genre").value = "R&B";
  document.getElementById("mood").value = "Melancholic";
  document.getElementById("length").value = "3 min";
  document.getElementById("voice").value = "Female";
};

form.addEventListener("submit", generateTracks);
document.getElementById("use-template").addEventListener("click", applyTemplate);

renderTracks(seedTracks);
